---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---

<BaseLayout title="Contato — Pedro Celestino">
  <div class="site-container">
    <Header active="contato" />

    <main class="contact-page">
      <section class="contact-information">

        <div class="contact-item">
          <div class="contact-icon">
            <img
  src="/images/projects/email-icon.svg"
  alt=""
  class="nav-icon"
/>
          </div>

          <div>
            <h1>Você pode me mandar um email</h1>

            <p>
              Pode levar algumas horas pra responder, mas calma!
              A qualquer momento eu te retorno.
            </p>

            <a href="mailto:pedrocelarques77@gmail.com">
              pedrocelarques77@gmail.com
            </a>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-icon">
            <img src="/images/projects/whatsapp (1).svg" alt="Logo Whatsapp" />
          </div>

          <div>
            <h2>Dá pra mandar mensagem também!</h2>

            <p>
              Alguns minutos e já te respondo, pera lá!
            </p>

            <a href="#">
              +55 81 986490186
            </a>
          </div>
        </div>

        <div class="social-links">
  <a href="SEU-LINK-FACEBOOK" target="_blank" aria-label="Facebook">
    <img src="/images/projects/Facebook.svg" alt="" />
  </a>

  <a href="SEU-LINK-INSTAGRAM" target="_blank" aria-label="Instagram">
    <img src="/images/projects/instagram.png" alt="" />
  </a>

  <a href="SEU-LINK-BEHANCE" target="_blank" aria-label="Behance">
    <img src="/images/projects/behance.png" alt="" />
  </a>
</div>

</section>

<section class="contact-character-card">
  <img
    src="/images/projects/contact-doodle.webp"
    alt="Personagem de Pedro trabalhando em uma mesa"
    class="contact-doodle"
  />

  <a
    href="mailto:pedrocelarques77@gmail.com"
    class="contact-big-button"
  >
    <span>Entre em contato</span>

    <img
      src="/images/projects/up-arrow-right-icon.svg"
      alt=""
      class="contact-arrow"
    />
  </a>
</section>

</main>
</div>
</BaseLayout>