---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
---

<BaseLayout title="Colosso — Pedro Celestino">
  <div class="site-container">
    <Header />

    <main class="project-detail-page">
      <a href="/" class="back-link">
        <img
          src="/images/projects/back-button.svg"
          alt=""
          aria-hidden="true"
        />
        <span>Voltar</span>
      </a>

      <div class="project-detail-grid">
        <div class="project-detail-cover">
          <img
            src="/images/projects/idv-colosso.webp"
            alt="Identidade visual Colosso"
          />
        </div>

        <article class="project-article">
          <div class="project-heading">
            <span class="project-label">
              Identidade visual
            </span>

            <h1>Colosso</h1>

            <p>
              Um projeto de identidade visual desenvolvido para
              construir uma marca forte, reconhecível e consistente
              em diferentes pontos de contato.
            </p>
          </div>

          <section>
            <span class="project-label">Conceito</span>

            <h2>Construindo a personalidade da marca</h2>

            <p>
              A identidade foi desenvolvida a partir da definição
              de uma linguagem visual própria, buscando equilibrar
              personalidade, reconhecimento e versatilidade.
            </p>
          </section>

          <section class="colosso-showcase">
            <span class="project-label">Identidade</span>

            <h2>O sistema visual</h2>

            <div class="colosso-image colosso-image--large">
              <img
                src="/images/projects/logo-grid-colosso.webp"
                alt="Sistema de identidade visual da Colosso"
              />
            </div>
          </section>

          <section class="colosso-showcase">
            <span class="project-label">Tipografia</span>

            <h2>Uma família, diferentes pesos</h2>

            <div class="colosso-image colosso-image--large">
              <img
                src="/images/projects/colosso-usa-fonte.gif"
                alt="Pesos tipográficos utilizados na identidade Colosso"
              />
            </div>
          </section>

          <section class="colosso-showcase">
            <span class="project-label">Cores</span>

            <h2>Paleta visual</h2>

            <div class="colosso-image colosso-image--large">
              <img
                src="/images/projects/colosso-paleta.webp"
                alt="Paleta de cores da identidade Colosso"
              />
            </div>
          </section>

          <section class="colosso-showcase">
            <span class="project-label">Aplicações</span>

            <h2>A marca em uso</h2>

            <div class="colosso-gallery">
              <div class="colosso-image">
                <img
                  src="/images/projects/notebooks-colosso.webp"
                  alt="Aplicação da identidade Colosso"
                />
              </div>

              <div class="colosso-image">
                <img
                  src="/images/projects/placa-colosso.webp"
                  alt="Aplicação da identidade Colosso"
                />
              </div>
            </div>
          </section>

          <section>
            <span class="project-label">Meu papel</span>

            <h2>Da ideia à aplicação</h2>

            <p>
              Trabalhei na definição do conceito, construção da
              linguagem visual, desenvolvimento da identidade e
              criação das principais aplicações da marca.
            </p>
          </section>

          <section>
            <h2>Ferramentas</h2>

            <div class="project-tools">
              <span>Illustrator</span>
              <span>Photoshop</span>
              <span>Figma</span>
            </div>
          </section>
          <section class="project-visit">
  <a
    href="https://public.tableau.com/app/profile/pedro.celestino/viz/SAFRAMILHO2026-DASHBOARD/Painel1"
    target="_blank"
    rel="noopener noreferrer"
    class="project-visit-button"
  >
    <span>Ver no Behance</span>

    <span class="project-visit-icon">
      <img
        src="/images/projects/link-vazado.svg"
        alt=""
        aria-hidden="true"
      />
    </span>
  </a>
</section>
        </article>
      </div>
    </main>
  </div>
</BaseLayout>